generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum InterviewStatus {
  active
  completed
}
model Interview {
  id String @id @default(uuid()) @db.Uuid
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  requestId String @db.Uuid
  preferences Json
  status InterviewStatus @default(active)
  revision Int @default(0)
  generation Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  questions Question[]
  answers Answer[]
  feedback FeedbackReport?
  @@unique([ownerId, requestId])
  @@index([ownerId, createdAt])
}
model Question {
  interviewId String @db.Uuid
  id String
  position Int
  text String
  subject String
  metadata Json
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answers Answer[]
  @@id([interviewId, id])
  @@unique([interviewId, position])
}
model Answer {
  interviewId String @db.Uuid
  questionId String
  text String
  updatedAt DateTime @updatedAt
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [interviewId, questionId], references: [interviewId, id], onDelete: Cascade)
  @@id([interviewId, questionId])
}
model FeedbackReport {
  id String @id @default(uuid()) @db.Uuid
  interviewId String @unique @db.Uuid
  source String
  content Json
  modelVersion String?
  rubricVersion String?
  createdAt DateTime @default(now())
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model User {
  id String @id @default(uuid())
  clerkUserId String? @unique
  legacy Boolean @default(false)
  createdAt DateTime @default(now())
  interviews Interview[]
  aiOperations AiOperation[]
  resumes Resume[]
}

// Durable idempotency and usage ledger; no raw prompts/answers in telemetry fields.
model AiOperation {
  id String @id @default(uuid()) @db.Uuid
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key String
  kind String
  inputHash String
  status String
  result Json?
  model String
  rubric String
  attempts Int @default(0)
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId, key])
  @@index([ownerId, createdAt])
}

model Resume {
  id String @id @default(uuid()) @db.Uuid
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  state String @default("pending")
  objectKey String @unique
  filename String
  type String
  text String
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([ownerId, expiresAt])
}
