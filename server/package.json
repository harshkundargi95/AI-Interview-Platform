{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "vitest run",
    "lint": "oxlint src test scripts prisma/seed.js prisma.config.js",
    "db:local": "node scripts/local-database.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:db": "node scripts/test-database.js",
    "eval:ai": "node scripts/evaluate-ai.js"
  },
  "dependencies": {
    "@clerk/express": "^2.1.77",
    "@google/genai": "^2.28.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.87.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
