PORT=3001
# Local helper started with npm run db:local; this password is for local development only.
DATABASE_URL=postgresql://interview_dev:local-development-only@127.0.0.1:55432/interview_dev
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Required: copy from your Clerk application. Never use VITE_ for secret keys.
CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
# Optional Clerk JWT public key for networkless verification; not a private key.
# CLERK_JWT_KEY=

# Phase 6: mock makes no provider calls. Live mode requires BOTH values below.
AI_MODE=mock
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite

# Phase 8: optional voice. If omitted, inherits AI_MODE (mock by default).
# disabled keeps all typed-answer features available. Uses GEMINI_API_KEY above.
# VOICE_MODE=mock
# Optional transcription model override; otherwise uses GEMINI_MODEL.
# VOICE_MODEL=gemini-3.5-flash-lite

# Shared operation ceilings, including failed calls (not a currency budget).
AI_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=500

# Production hosting settings (keep local defaults above for development):
# NODE_ENV=production
# DATABASE_TRANSPORT=render-internal
# For other hosted PostgreSQL: DATABASE_TRANSPORT=tls (verified certificates).
# DATABASE_CA_CERT=optional PEM certificate with escaped newlines
# S3_ENDPOINT=https://s3.REGION.amazonaws.com
# S3_REGION=YOUR_REGION
# S3_BUCKET=YOUR_PRIVATE_BUCKET
# S3_ACCESS_KEY_ID=YOUR_RESTRICTED_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=YOUR_RESTRICTED_SECRET
# S3_FORCE_PATH_STYLE=false
# RESUME_LINK_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
# Hosted runtime requires exact HTTPS CORS_ORIGINS and AI_MODE=live.
# Default production mode requires Clerk live keys; explicit demo uses test keys,
# and VOICE_MODE=live or disabled. Never deploy S3rver or embedded PostgreSQL.

# Free hosted demo: Render settings only; do not change local development defaults.
# DEPLOYMENT_MODE=demo
# NODE_ENV=production
# DATABASE_TRANSPORT=tls
# DATABASE_URL=YOUR_SUPABASE_SESSION_POOLER_URL_PORT_5432
# DATABASE_CA_CERT=YOUR_SUPABASE_CA_PEM
# Use matching Clerk pk_test_/sk_test_ keys with exact HTTPS CORS_ORIGINS.
# GEMINI_FREE_TIER_CONFIRMED=true (operator acknowledgement, NOT automatic billing verification)
# AI_DAILY_LIMIT=5
# AI_GLOBAL_DAILY_LIMIT=20
# S3_ENDPOINT=https://PROJECT.storage.supabase.co/storage/v1/s3
# S3_FORCE_PATH_STYLE=true
# Use a private Supabase Free bucket and its backend-only S3 credentials.
