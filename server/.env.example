PORT=3001
# Local helper started with npm run db:local; this password is for local development only.
DATABASE_URL=postgresql://interview_dev:local-development-only@127.0.0.1:55432/interview_dev
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Required: copy from your Clerk application. Never use VITE_ for secret keys.
CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
# Optional Clerk JWT public key for networkless verification; not a private key.
# CLERK_JWT_KEY=

# Phase 6: mock makes no provider calls. Live mode requires BOTH values below.
AI_MODE=mock
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
