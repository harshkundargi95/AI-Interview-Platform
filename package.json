{
  "name": "interview-practice",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace client -- --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspaces --if-present && oxlint shared",
    "preview": "npm run preview --workspace client -- --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev --workspace server",
    "db:local": "npm run db:local --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "test:db": "npm run test:db --workspace server",
    "storage:local": "npm run storage:local --workspace server"
  }
}
