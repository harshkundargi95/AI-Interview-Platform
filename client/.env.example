VITE_API_URL=http://127.0.0.1:3001/api/v1
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY

# Hosted Vercel builds require an HTTPS API URL ending in /api/v1.
# Default production mode requires pk_live_; explicit demo requires pk_test_.
# These public values are embedded at build time; never add server secrets here.

# Free hosted demo (Vercel): explicitly select demo and your matching pk_test_ key.
# VITE_DEPLOYMENT_MODE=demo
# VITE_API_URL=https://YOUR_API.onrender.com/api/v1
# Without demo mode, hosted builds continue to require pk_live_.
